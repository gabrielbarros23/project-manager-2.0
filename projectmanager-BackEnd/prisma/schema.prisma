datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                Int              @id @default(autoincrement())
  email             String           @unique
  name              String
  password          String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  projectsRelations ProjectMembers[]
  tasksRelations    TaskMembers[]
}

model Project {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  members     ProjectMembers[]
  tasks       Task[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProjectMembers {
  userId    Int
  projectId Int
  role      ProjectRole
  user      User        @relation(fields: [userId], references: [id], onDelete:Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Task {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  status      TaskStatus    @default(TODO)
  priority    TaskPriority
  dueDate     DateTime
  projectId   Int
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signedTo    TaskMembers[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TaskMembers {
  userId Int
  taskId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
}
